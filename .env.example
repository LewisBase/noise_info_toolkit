# Noise Info Toolkit field configuration
NIT_WATCH_DIR=./audio_files
NIT_DB_PATH=./Database/noise_info.db
NIT_EVENT_DIR=./audio_events
NIT_BACKEND_URL=http://127.0.0.1:8000
NIT_API_KEY=change-me
# Optional role keys.  If any is set, X-API-Key is required for data routes.
# NIT_OPERATOR_API_KEY=operator-secret
# NIT_CALIBRATOR_API_KEY=calibrator-secret
# NIT_ADMIN_API_KEY=admin-secret

NIT_READ_WINDOW_S=10
NIT_ANALYSIS_STEP_S=1
NIT_PERSIST_WINDOW_S=10
NIT_BAND_ORDER=4

NIT_EVENT_PRE_S=5
NIT_EVENT_POST_S=10
NIT_EVENT_MAX_S=60
NIT_EVENT_MIN_GAP_S=2

# Keep debug until field acceptance is complete.  Debug NEVER deletes audio.
NIT_RETENTION_MODE=debug
NIT_DELETE_SOURCE_AFTER_DAYS=7
NIT_EVENT_RETENTION_DAYS=365
NIT_RETENTION_DRY_RUN=true

# Optional directory allow-list.  Empty means unrestricted (development/demo
# only).  In production set e.g. ["D:\\NoiseData"].
NIT_ALLOWED_WATCH_ROOTS=[]

NIT_EXPORT_DIR=./exports
NIT_AUTO_EXPORT_ON_STOP=true

# TDMS files without wf_increment/SampleRate are common from some recorders.
# Set the actual recorder rate; 48000 is the field default and is recorded in
# the file result as an estimated rate.
NIT_TDMS_FALLBACK_FS=48000

# Browser origins allowed to consume SSE/WebSocket from Streamlit.
NIT_CORS_ORIGINS=["http://127.0.0.1:8501","http://localhost:8501"]
